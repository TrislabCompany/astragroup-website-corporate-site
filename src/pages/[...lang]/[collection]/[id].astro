---
// The page of one service or one project.
//
// A service: a photo head (with a link to the extension site on the facade
// and roofing pages), what the group includes, the text, then the blocks a
// longer service page has (the kinds, what the price depends on, the
// extension site, how the work runs, common questions), its projects.
// A project: its cover as the head, the type of work (and the place and year
// once confirmed), its services, the text and its gallery: only its own photos.
import { Image } from "astro:assets";
import { getEntry, render, type CollectionEntry } from "astro:content";
import ContactBand from "../../../components/ContactBand.astro";
import ExtensionSiteLink from "../../../components/ExtensionSiteLink.astro";
import FaqList from "../../../components/FaqList.astro";
import HeadPhotoPreload from "../../../components/HeadPhotoPreload.astro";
import KindGrid from "../../../components/KindGrid.astro";
import PriceFactors from "../../../components/PriceFactors.astro";
import ProjectCard from "../../../components/ProjectCard.astro";
import ProjectGallery from "../../../components/ProjectGallery.astro";
import StepList from "../../../components/StepList.astro";
import { seoProps } from "../../../components/seo/fields";
import { localizedPath, t, type Lang } from "../../../i18n";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { projectsOf, servicesOf, type Project, type Service } from "../../../lib/catalog";
import { entrySlug } from "../../../lib/content";
import { collectionSettings, itemPaths, type ItemCollection } from "../../../lib/items";
import { head as headPhoto } from "../../../lib/images";

export const getStaticPaths = itemPaths;

const { entry, lang, collection, available } = Astro.props as {
  entry: CollectionEntry<ItemCollection>;
  lang: Lang;
  collection: ItemCollection;
  available: Lang[];
};
const settings = collectionSettings(collection);
const { Content } = await render(entry);

const service = collection === "services" ? (entry as Service) : undefined;
const project = collection === "projects" ? (entry as Project) : undefined;
const head = service?.data.photo ?? project?.data.cover;
const related = service ? await projectsOf(service, lang) : [];
const projectServices = project ? await servicesOf(project, lang) : [];
// A service's own steps, or else how any job runs (the home page's steps).
const steps = service ? (service.data.process ?? (await getEntry("pages", `${lang}/home`))?.data.steps) : undefined;
const extension = service?.data.extensionSite;
---

<BaseLayout {...seoProps(entry.data)} description={entry.data.summary} lang={lang} available={available}>
  {head && <HeadPhotoPreload slot="head" src={head.src} />}
  <section class="photo-head bleed" aria-labelledby="item-title">
    {head && <Image src={head.src} alt={head.alt} {...headPhoto} loading="eager" fetchpriority="high" class="hero-photo" />}
    <div class="wrap hero-text">
      <div class="hero-panel">
        <p class="eyebrow"><a href={localizedPath(lang, `/${collection}`)}>{settings.title[lang]}</a></p>
        <h1 id="item-title">{entry.data.title}</h1>
        <p class="hero-lead">{entry.data.summary}</p>
        {
          service && (
            <p class="actions">
              <a class="button" href={localizedPath(lang, "/contact")}>{t(lang, "service.ask")}</a>
              {extension && (
                <a class="button ghost" href={extension.url} hreflang="sl">
                  {t(lang, "service.moreOn")} {extension.name} →
                </a>
              )}
            </p>
          )
        }
      </div>
    </div>
  </section>

  {
    service && (
      <div class="service-intro">
        <section aria-labelledby="includes">
          <h2 id="includes">{t(lang, "service.includes")}</h2>
          <ul class="checklist">
            {service.data.features.map((feature) => (
              <li>{feature}</li>
            ))}
          </ul>
        </section>
        <div class="prose">
          <Content />
        </div>
      </div>
    )
  }

  {
    project && (
      <div class="service-intro">
        <dl class="facts">
          <dt>{t(lang, "project.type")}</dt>
          <dd>{project.data.type}</dd>
          {project.data.place && (
            <>
              <dt>{t(lang, "project.place")}</dt>
              <dd>{project.data.place}</dd>
            </>
          )}
          {project.data.year && (
            <>
              <dt>{t(lang, "project.year")}</dt>
              <dd>{project.data.year}</dd>
            </>
          )}
          <dt>{t(lang, "project.services")}</dt>
          <dd>
            <ul class="inline-list">
              {projectServices.map((item) => (
                <li>
                  <a href={localizedPath(lang, `/services/${entrySlug(item)}`)}>{item.data.title}</a>
                </li>
              ))}
            </ul>
          </dd>
        </dl>
        <div class="prose">
          <Content />
        </div>
      </div>
    )
  }

  {project && <ProjectGallery photos={project.data.gallery} lang={lang} />}

  {service?.data.kinds && <KindGrid {...service.data.kinds} />}

  {service?.data.priceFactors && <PriceFactors {...service.data.priceFactors} lang={lang} />}

  {extension && <ExtensionSiteLink site={extension} lang={lang} />}

  {steps && <StepList title={steps.title} lead={steps.lead} items={steps.items} />}

  {service?.data.faq && <FaqList {...service.data.faq} />}

  {
    related.length > 0 && (
      <section class="section" aria-labelledby="related">
        <h2 id="related">{t(lang, "service.projects")}</h2>
        <ul class="card-grid">
          {related.map((item) => (
            <ProjectCard project={item} lang={lang} />
          ))}
        </ul>
      </section>
    )
  }

  <ContactBand lang={lang} />
</BaseLayout>
