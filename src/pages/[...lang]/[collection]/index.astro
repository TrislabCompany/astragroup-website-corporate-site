---
// The list pages: /<lang>/services and /<lang>/projects.
import ContactBand from "../../../components/ContactBand.astro";
import ProjectCard from "../../../components/ProjectCard.astro";
import ServiceCard from "../../../components/ServiceCard.astro";
import { type Lang } from "../../../i18n";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { projects, services } from "../../../lib/catalog";
import { collectionPaths, collectionSettings, type ItemCollection } from "../../../lib/items";

export const getStaticPaths = collectionPaths;

const { lang, collection } = Astro.props as { lang: Lang; collection: ItemCollection };
const settings = collectionSettings(collection);
const serviceList = collection === "services" ? await services(lang) : [];
const projectList = collection === "projects" ? await projects(lang) : [];
---

<BaseLayout title={settings.title[lang]} description={settings.lead[lang]} lang={lang}>
  <div class="page-head">
    <h1>{settings.title[lang]}</h1>
    <p class="lead">{settings.lead[lang]}</p>
  </div>
  <ul class="card-grid">
    {serviceList.map((service) => <ServiceCard service={service} lang={lang} level={2} />)}
    {projectList.map((project) => <ProjectCard project={project} lang={lang} level={2} />)}
  </ul>
  <ContactBand lang={lang} />
</BaseLayout>
