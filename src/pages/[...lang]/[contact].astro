---
import ContactDetails from "../../components/ContactDetails.astro";
import { pagePaths, t, type Lang } from "../../i18n";
import BaseLayout from "../../layouts/BaseLayout.astro";

export const getStaticPaths = () => pagePaths("contact");

const { lang } = Astro.props as { lang: Lang };
---

<BaseLayout title={t(lang, "contact.title")} description={t(lang, "contact.lead")} lang={lang}>
  <div class="page-head">
    <h1>{t(lang, "contact.title")}</h1>
    <p class="lead">{t(lang, "contact.lead")}</p>
  </div>
  <ContactDetails lang={lang} />
</BaseLayout>
