---
// About the company: who it is and how it works (src/content/pages/<lang>/about.md),
// then the vision, mission, values and goals as a short list.
import { getEntry, render } from "astro:content";
import ContactBand from "../../components/ContactBand.astro";
import { pagePaths, t, type Lang } from "../../i18n";
import BaseLayout from "../../layouts/BaseLayout.astro";

export const getStaticPaths = () => pagePaths("about");

const { lang } = Astro.props as { lang: Lang };
const page = await getEntry("pages", `${lang}/about`);
if (!page) throw new Error(`src/content/pages/${lang}/about.md is missing.`);
const { Content } = await render(page);
---

<BaseLayout title={page.data.title} description={page.data.description} lang={lang}>
  <div class="page-head">
    <h1>{page.data.title}</h1>
    {page.data.intro && <p class="lead">{page.data.intro}</p>}
  </div>
  <div class="prose">
    <Content />
  </div>
  {
    page.data.principles.length > 0 && (
      <section class="section" aria-labelledby="principles">
        <h2 id="principles">{t(lang, "about.principles")}</h2>
        <dl class="principles">
          {page.data.principles.map((item) => (
            <div>
              <dt>{item.title}</dt>
              <dd>{item.text}</dd>
            </div>
          ))}
        </dl>
      </section>
    )
  }
  <ContactBand lang={lang} />
</BaseLayout>
