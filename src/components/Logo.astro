---
// The Astra Group logo, white, for the navy header and footer: public/logo.svg,
// traced from the earlier site's logo. One file, cached once for every page.
// Its alternative text is the company's name, which the logo spells out.
import site from "../site.config";

interface Props {
  /** The height in CSS pixels; the width follows the logo's proportions. */
  height?: number;
}

const { height = 64 } = Astro.props;
// public/logo.svg has the viewBox 1277 × 1482.
const width = Math.round((height * 1277) / 1482);
---

<img class="logo" src="/logo.svg" alt={site.name} width={width} height={height} />
