---
// The kinds of a service (kinds of facade, kinds of roof covering) as a grid of short cards.
interface Props {
  title: string;
  lead?: string;
  items: { title: string; text: string }[];
  /** The id of the heading, for the section's aria-labelledby. */
  id?: string;
}

const { title, lead, items, id = "kinds" } = Astro.props;
---

<section class="section" aria-labelledby={id}>
  <h2 id={id}>{title}</h2>
  {lead && <p class="lead">{lead}</p>}
  <ul class="kind-grid">
    {
      items.map((item) => (
        <li>
          <h3>{item.title}</h3>
          <p>{item.text}</p>
        </li>
      ))
    }
  </ul>
</section>
