---
// A preload of the full-width head photo, so the browser fetches it with the HTML, before the styles and fonts.
// The same options as the <Image> of the head (src/lib/images.ts) give the same files.
import { getImage } from "astro:assets";
import type { ImageMetadata } from "astro";
import { head } from "../lib/images";

interface Props {
  src: ImageMetadata;
}

const { src } = Astro.props;
const image = await getImage({ src, ...head });
---

<link rel="preload" as="image" type="image/avif" imagesrcset={image.srcSet.attribute} imagesizes={head.sizes} fetchpriority="high" />
