---
// The contact details from src/site.config.ts: phone and e-mail links first,
// then the address with a map link, then the company details. No form and no
// embedded map: the site has no backend and loads no outside service.
import { t, type Lang } from "../i18n";
import site from "../site.config";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const { company, contact } = site;
---

<div class="contact-grid">
  <section class="contact-panel" aria-labelledby="contact-direct">
    <h2 id="contact-direct">{t(lang, "band.title")}</h2>
    {
      contact.phone && (
        <>
          <h3>{t(lang, "contact.phone")}</h3>
          <p>
            <a class="button" href={`tel:${contact.phone.replace(/\s/g, "")}`}>
              {contact.phone}
            </a>
          </p>
        </>
      )
    }
    {
      contact.topics.length > 0 && (
        <>
          <h3>{t(lang, "contact.email")}</h3>
          <ul>
            {contact.topics.map(({ email, label }) => (
              <li>
                {label[lang]}: <a href={`mailto:${email}`}>{email}</a>
              </li>
            ))}
          </ul>
        </>
      )
    }
  </section>

  <section aria-labelledby="contact-address">
    <h2 id="contact-address">{t(lang, "contact.address")}</h2>
    <address>
      {company.legalName}<br />
      {company.address.street}<br />
      {`${company.address.postalCode} ${company.address.city}`}
    </address>
    {
      contact.mapUrl && (
        <p>
          <a href={contact.mapUrl} rel="noopener noreferrer">
            {t(lang, "contact.map")}
          </a>
        </p>
      )
    }
    {
      contact.googleBusinessUrl && (
        <p>
          <a href={contact.googleBusinessUrl} rel="noopener noreferrer">
            {t(lang, "contact.googleBusiness")}
          </a>
        </p>
      )
    }

    <h2>{t(lang, "contact.company")}</h2>
    <dl class="imprint">
      <dt>{t(lang, "imprint.company")}</dt>
      <dd>{company.legalName}</dd>
      {
        company.registrationNumber && (
          <>
            <dt>{t(lang, "imprint.registrationNumber")}</dt>
            <dd>{company.registrationNumber}</dd>
          </>
        )
      }
      {
        company.vatId && (
          <>
            <dt>{t(lang, "imprint.vatId")}</dt>
            <dd>{company.vatId}</dd>
          </>
        )
      }
    </dl>
  </section>
</div>
