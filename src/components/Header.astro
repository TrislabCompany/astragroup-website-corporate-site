---
// The navy site header: logo, main menu, language switch and phone link. On a
// phone the menu folds into a <details> disclosure, which opens without
// JavaScript; the two menus are never shown at the same time.
import { localizedPath, t, type Lang } from "../i18n";
import { services } from "../lib/catalog";
import { entrySlug } from "../lib/content";
import site from "../site.config";
import LanguageSwitch from "./LanguageSwitch.astro";
import Logo from "./Logo.astro";

interface Props {
  lang: Lang;
  path: string;
  available?: readonly Lang[];
}

const { lang, path, available } = Astro.props;
const list = (id: string) => site.collections.find((collection) => collection.id === id);
const links = [
  { href: "/", label: t(lang, "nav.home") },
  { href: "/about", label: t(lang, "nav.about") },
  { href: "/services", label: list("services")?.title[lang] ?? t(lang, "nav.services") },
  { href: "/projects", label: list("projects")?.title[lang] ?? "" },
  { href: "/contact", label: t(lang, "nav.contact") },
].filter((link) => link.label);
const serviceLinks = (await services(lang)).map((service) => ({ href: `/services/${entrySlug(service)}`, label: service.data.title }));
// A section's link stays marked on its detail pages (/services/fasade).
const current = (href: string) => (href === "/" ? path === "/" : path === href || path.startsWith(`${href}/`));
const phone = site.contact.phone;
---

<header class="site-header">
  <div class="wrap header-row">
    <a class="brand" href={localizedPath(lang)}>
      <Logo height={56} />
    </a>

    <nav class="main-nav desktop-only" aria-label={t(lang, "nav.main")}>
      <ul>
        {
          links.map(({ href, label }) => (
            <li>
              <a href={localizedPath(lang, href)} aria-current={current(href) ? "page" : undefined}>
                {label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="header-tools">
      <LanguageSwitch lang={lang} path={path} available={available} />
      {
        phone && (
          <a class="header-phone desktop-only" href={`tel:${phone.replace(/\s/g, "")}`}>
            {phone}
          </a>
        )
      }
    </div>

    <details class="mobile-menu mobile-only">
      <summary>{t(lang, "nav.menu")}</summary>
      <nav aria-label={t(lang, "nav.main")}>
        <ul>
          {
            links.map(({ href, label }) => (
              <li>
                <a href={localizedPath(lang, href)} aria-current={current(href) ? "page" : undefined}>
                  {label}
                </a>
                {href === "/services" && (
                  <ul>
                    {serviceLinks.map((service) => (
                      <li>
                        <a href={localizedPath(lang, service.href)} aria-current={current(service.href) ? "page" : undefined}>
                          {service.label}
                        </a>
                      </li>
                    ))}
                  </ul>
                )}
              </li>
            ))
          }
        </ul>
      </nav>
    </details>
  </div>

  {/* Fixed at the bottom of a phone screen, inside the banner landmark. */}
  {
    phone && (
      <a class="call-button mobile-only" href={`tel:${phone.replace(/\s/g, "")}`}>
        <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24">
          <path
            fill="currentColor"
            d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.25 11.4 11.4 0 0 0 3.6.57 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.45.57 3.57a1 1 0 0 1-.25 1z"
          />
        </svg>
        {t(lang, "cta.call")}
      </a>
    )
  }
</header>
