---
// The photos of a project as a grid. Each photo links to a large version that
// the browser opens on its own: no script and no gallery library.
import { getImage, Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import { t, type Lang } from "../i18n";
import { card, large as largePhoto } from "../lib/images";

interface Props {
  photos: { src: ImageMetadata; alt: string }[];
  lang: Lang;
}

const { photos, lang } = Astro.props;
const large = await Promise.all(photos.map((photo) => getImage({ src: photo.src, ...largePhoto, width: Math.min(photo.src.width, largePhoto.width) })));
---

{
  photos.length > 0 && (
    <section class="gallery" aria-labelledby="gallery">
      <h2 id="gallery">{t(lang, "project.gallery")}</h2>
      <ul class="gallery-grid">
        {photos.map((photo, i) => (
          <li>
            <a href={large[i]!.src}>
              <Image src={photo.src} alt={`${photo.alt} (${t(lang, "project.photoLarge")})`} {...card} />
            </a>
          </li>
        ))}
      </ul>
    </section>
  )
}
